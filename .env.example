# Copy to .env and replace placeholders. Never commit real secrets.

PORT=8080
POLL_INTERVAL=5m
REQUEST_TIMEOUT=15s

# OpenCode: base key plus optional suffixed keys (_R, _ALICE, ...).
OPENCODE_GO_API_KEY=sk-replace-me
# OPENCODE_GO_API_KEY_R=sk-replace-me

# Cursor: prefer the user API key; the OAuth refresh is the historical mode.
# CURSOR_API_KEY=crsr_replace_me
# CURSOR_REFRESH_TOKEN=replace_me

# Devin: token and optional organisation.
# DEVIN_API_KEY=cog_replace_me
# DEVIN_ORG_ID=org-replace-me
# DEVIN_RESET_DAY=5
# DEVIN_API_SERVER=https://server.codeium.com
