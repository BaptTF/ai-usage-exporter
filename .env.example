# Copy to .env and replace placeholders. Never commit real secrets.

PORT=8080
POLL_INTERVAL=5m
REQUEST_TIMEOUT=15s

# OpenCode: one variable per subscription. The suffix becomes the label.
# The bare OPENCODE_GO_API_KEY remains optional for legacy deployments.
OPENCODE_GO_API_KEY_B=sk-replace-me
# OPENCODE_GO_API_KEY_R=sk-replace-me
# OPENCODE_GO_API_KEY_A=sk-replace-me
# OPENCODE_GO_API_KEY_N=sk-replace-me

# Cursor: one credential per subscription. The suffix becomes the label.
# CURSOR_API_KEY_R_PERSONAL -> r_personal
# CURSOR_API_KEY_B_PERSONAL -> b_personal
# CURSOR_API_KEY_B_STUDENT  -> b_student
# CURSOR_API_KEY_R_PERSONAL=crsr_replace_me
# CURSOR_API_KEY_B_PERSONAL=crsr_replace_me
# CURSOR_API_KEY_B_STUDENT=crsr_replace_me

# Cursor OAuth fallback. The bare variable belongs only to r_personal, the
# renamed historical credential; use the suffixed form for any other label.
# CURSOR_REFRESH_TOKEN=replace_me
# CURSOR_REFRESH_TOKEN_B_STUDENT=replace_me

# Devin: token and optional organisation.
# DEVIN_API_KEY=cog_replace_me
# DEVIN_ORG_ID=org-replace-me
# DEVIN_RESET_DAY=5
# DEVIN_API_SERVER=https://server.codeium.com
